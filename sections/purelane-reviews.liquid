<style>

.purelane-reviews {
  padding: 80px 0;
  background: #f5f1eb;
  color: #17202c;
  overflow: hidden;
}

.purelane-reviews__header {
  max-width: 1180px;
  margin: 0 auto 40px;
  padding: 0 24px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.purelane-reviews__kicker {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.purelane-reviews__stats {
  font-size: 14px;
  color: #555;
}

.purelane-reviews__stats span {
  color: #c9761d;
  letter-spacing: 2px;
}

.purelane-reviews__stats b {
  color: #17202c;
}


.purelane-reviews__rail {
  width: 100%;
  overflow: hidden;
}

.purelane-reviews__track {
  display: flex;
  width: max-content;
  gap: 18px;

  animation: purelaneReviewsScroll 35s linear infinite;
}

.purelane-review-card {
  width: 330px;
  min-height: 250px;
  padding: 26px;

  flex-shrink: 0;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.95),
      rgba(236,230,247,.72)
    );

  border: 1px solid rgba(23,32,44,.10);

  box-shadow:
    0 20px 50px rgba(23,32,44,.10);

  display: flex;
  flex-direction: column;
}

.purelane-review-card__stars {
  color: #c9761d;
  font-size: 16px;
  letter-spacing: 2px;
}

.purelane-review-card h3 {
  margin: 16px 0 10px;

  font-size: 20px;
  line-height: 1.2;
}

.purelane-review-card p {
  margin: 0;

  color: #555;
  font-size: 14px;
  line-height: 1.65;
}

.purelane-review-card__person {
  margin-top: auto;
  padding-top: 22px;

  display: flex;
  align-items: center;
  gap: 7px;

  font-size: 13px;
}

.purelane-review-card__person span {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 20px;
  height: 20px;

  border-radius: 50%;

  background: #17202c;
  color: #fff;

  font-size: 11px;
}

.purelane-review-card__person small {
  color: #777;
}


@keyframes purelaneReviewsScroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}


@media screen and (max-width: 749px) {

  .purelane-reviews {
    padding: 55px 0;
  }

  .purelane-reviews__header {
    padding: 0 18px;
    flex-direction: column;
    align-items: flex-start;
  }

  .purelane-review-card {
    width: 285px;
    min-height: 240px;
    padding: 22px;
  }

}

</style>


{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Purelane Reviews"
    }
  ]
}
{% endschema %}