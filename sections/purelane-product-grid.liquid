<section class="purelane-products" id="shop">
  <div class="purelane-products__container">

    {% if section.settings.eyebrow != blank %}
      <p class="purelane-products__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="purelane-products__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="purelane-products__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      <div class="purelane-products__grid">
        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}
          <article class="purelane-product-card">

            <a
              href="{{ product.url }}"
              class="purelane-product-card__image"
            >
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    alt: product.featured_image.alt
                }}
              {% else %}
                <div class="purelane-product-card__placeholder">
                  No image
                </div>
              {% endif %}
            </a>

            <div class="purelane-product-card__info">

              {% unless product.available %}
                <span class="purelane-product-card__sold-out">
                  Sold out
                </span>
              {% endunless %}

              <h3 class="purelane-product-card__title">
                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>
              </h3>

              <div class="purelane-product-card__price">
                {{ product.price | money }}
              </div>

              <a
                href="{{ product.url }}"
                class="purelane-product-card__button"
              >
                View product
              </a>

            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}
  .purelane-products {
    padding: 70px 24px;
    background: #ffffff;
  }

  .purelane-products__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .purelane-products__eyebrow {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .purelane-products__heading {
    margin: 0;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
  }

  .purelane-products__description {
    max-width: 650px;
    margin: 16px 0 40px;
    line-height: 1.6;
  }

  .purelane-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .purelane-product-card {
    min-width: 0;
  }

  .purelane-product-card__image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f3f3f3;
  }

  .purelane-product-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .purelane-product-card__placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-size: 14px;
  }

  .purelane-product-card__info {
    padding-top: 14px;
  }

  .purelane-product-card__sold-out {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .purelane-product-card__title {
    margin: 0;
    font-size: 17px;
    line-height: 1.35;
  }

  .purelane-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .purelane-product-card__price {
    margin-top: 8px;
    font-size: 16px;
  }

  .purelane-product-card__button {
    display: inline-block;
    margin-top: 14px;
    padding: 10px 16px;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
  }

  @media screen and (max-width: 989px) {
    .purelane-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 549px) {
    .purelane-products {
      padding: 50px 16px;
    }

    .purelane-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .purelane-product-card__title {
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our cleaning essentials"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Simple, effective products for a cleaner everyday home.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}