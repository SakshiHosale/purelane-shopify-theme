}

/* badge rail */
.purelane-exact-hero .badges{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:96px;z-index:4;
  display:flex;flex-direction:column;gap:2px;padding:12px 8px;border-radius:20px}
.purelane-exact-hero .badge{text-align:center;padding:11px 4px}
.badge+.purelane-exact-hero .badge{border-top:1px solid rgba(236,230,247,.14)}
.purelane-exact-hero .badge .bi{width:38px;height:38px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;
  background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);color:var(--accent)}
.purelane-exact-hero .badge .bi svg{width:19px;height:19px}
.purelane-exact-hero .badge span{display:block;font-size:8.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--paper-2);line-height:1.34}
@media(max-width:900px){.purelane-exact-hero .badges{display:none}}

/* mobile badge strip */
.purelane-exact-hero .badgestrip{display:flex;gap:8px;margin-top:24px}
.purelane-exact-hero .badgestrip div{flex:1;text-align:center;padding:11px 6px;border-radius:14px;font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-2);line-height:1.3}
.purelane-exact-hero .badgestrip svg{width:18px;height:18px;margin:0 auto 6px;color:var(--accent)}
@media(min-width:901px){.purelane-exact-hero .badgestrip{display:none}}

