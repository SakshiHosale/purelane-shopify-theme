<style>

.purelane-exact-hero{--maxw:1180px;--sec-y:56px;--ease:cubic-bezier(.2,.8,.2,1);--accent:#b8701c;--surface:#17102b;--paper-2:rgba(36,26,61,.78);--paper-3:rgba(36,26,61,.56);position:relative;background:linear-gradient(178deg,#fbfffb 0%,#eafaec 24%,#d6f1dc 54%,#bfe8ca 100%);overflow:hidden;color:#241a3d;min-height:100svh;}
.purelane-exact-hero .hero{min-height:100svh;}
.purelane-exact-hero .hero-grid{max-width:var(--maxw);}
.purelane-exact-hero .hero h1{font-family:inherit;font-size:clamp(64px,8vw,118px);line-height:.84;letter-spacing:-.055em;color:#17102b;}
.purelane-exact-hero .lime{color:#4f7d10;}
.purelane-exact-hero .lede{max-width:540px;font-size:15px;line-height:1.65;color:rgba(36,26,61,.78);}
.purelane-exact-hero .btn{display:inline-flex;align-items:center;gap:10px;padding:13px 19px;border-radius:999px;text-decoration:none;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;}
.purelane-exact-hero .btn-primary{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6;}
.purelane-exact-hero .btn-ghost{background:rgba(255,255,255,.66);border:1px solid rgba(75,58,143,.22);color:#01423b;}
.purelane-exact-hero .glass-2{background:linear-gradient(158deg,rgba(255,255,255,.66),rgba(236,230,247,.44));border:1px solid rgba(75,58,143,.13);box-shadow:0 16px 38px rgba(58,44,112,.10),inset 0 1px 0 rgba(255,255,255,.86);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
:root{
--p-kbtl:url("data:image/svg+xml;base64,");
--p-tbtl:url("data:image/svg+xml;base64,");
--p-mbtl:url("data:image/svg+xml;base64,");
}
.purelane-exact-hero .hero{position:relative;z-index:2;min-height:100svh;display:flex;align-items:flex-end;padding:150px 0 var(--sec-y)}
.purelane-exact-hero .hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(102deg,rgba(1,45,42,.68) 0%,rgba(1,45,42,.40) 30%,rgba(1,45,42,.10) 52%,transparent 66%)}
@media(max-width:900px){.purelane-exact-hero .hero::before{
  background:linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%)}}
.purelane-exact-hero .hero-grid{max-width:var(--maxw);margin:0 auto;padding:0 18px;width:100%;position:relative;z-index:2}
.purelane-exact-hero .hero-copy{max-width:600px;position:relative;z-index:3}
.purelane-exact-hero .hero h1{margin-bottom:20px;text-shadow:0 6px 40px rgba(2,20,19,.55)}
.purelane-exact-hero .rule{display:flex;align-items:center;gap:13px;margin:0 0 20px;max-width:270px}
.purelane-exact-hero .rule i{height:1px;flex:1;background:linear-gradient(90deg,rgba(236,230,247,.44),transparent)}
.purelane-exact-hero .rule svg{width:16px;height:16px;color:var(--accent);flex:0 0 auto}
.purelane-exact-hero .hero-cta{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}

/* hero product stage - matched to supplied homepage */
.purelane-exact-hero .hstage{position:relative;width:100%;height:clamp(380px,74svh,680px)}
.purelane-exact-hero .hslide{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;padding-right:2%;opacity:0;pointer-events:none;transition:opacity .85s var(--ease)}
.purelane-exact-hero .hslide.on{opacity:1;pointer-events:auto}
.purelane-exact-hero .hp{position:relative;width:auto;flex:0 0 auto;background-repeat:no-repeat;background-position:center bottom;background-size:contain;opacity:0;transform:translateY(28px) scale(.94);transition:opacity .8s var(--ease),transform .8s var(--ease);filter:drop-shadow(0 26px 40px rgba(1,22,20,.66))}
.purelane-exact-hero .hslide.on .hp{opacity:1;transform:none}
.purelane-exact-hero .hslide.on .hp.d1{transition-delay:.06s}
.purelane-exact-hero .hslide.on .hp.d2{transition-delay:.30s}
.purelane-exact-hero .hslide.on .hp.d3{transition-delay:.54s}
.purelane-exact-hero .hs1 .a{height:100%;z-index:3}
.purelane-exact-hero .hs2 .a{height:80%;margin-right:-8%;z-index:1}
.purelane-exact-hero .hs2 .b{height:97%;z-index:3}
.purelane-exact-hero .hs3 .a{height:75%;margin-right:-8%;z-index:1;order:1}
.purelane-exact-hero .hs3 .c{height:97%;z-index:3;order:2}
.purelane-exact-hero .hs3 .b{height:79%;margin-left:-8%;z-index:2;order:3}
.purelane-exact-hero .ptag{position:absolute;left:0;bottom:2%;z-index:6;padding:11px 14px 12px;border-radius:16px;max-width:52%;opacity:0;transform:translateY(16px);transition:opacity .8s var(--ease) .62s,transform .8s var(--ease) .62s}
.purelane-exact-hero .hslide.on .ptag{opacity:1;transform:none}
.purelane-exact-hero .ptag .lbl{display:block;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:var(--accent)}
.purelane-exact-hero .ptag .val{display:flex;align-items:baseline;gap:7px;margin-top:5px}
.purelane-exact-hero .ptag .val strong{font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--surface);line-height:1}
.purelane-exact-hero .ptag .val s{font-size:12px;color:var(--paper-3)}
.purelane-exact-hero .ptag .cut{display:inline-block;margin-top:7px;font-size:8.4px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:rgba(240,160,60,.20);border:1px solid rgba(240,160,60,.38);color:var(--accent)}
.purelane-exact-hero .hdots{display:flex;gap:7px;justify-content:center;align-items:center;margin-top:8px;position:relative;z-index:7}
.purelane-exact-hero .hdots button{width:6px;height:6px;padding:0;border:0;border-radius:50%;background:rgba(236,230,247,.28);transition:.4s var(--ease);cursor:pointer}
.purelane-exact-hero .hdots button.on{background:var(--accent);width:20px;border-radius:999px}
@media(max-width:900px){.purelane-exact-hero .hstage{height:clamp(300px,44svh,430px)}.purelane-exact-hero .ptag{padding:9px 12px 10px;border-radius:14px;max-width:58%}}

/* product */
.purelane-exact-hero .hero-prod{position:absolute;right:2%;bottom:28px;width:min(50vw,560px);z-index:2;
  filter:drop-shadow(0 34px 54px rgba(2,20,19,.6))}
@media(max-width:1200px){
